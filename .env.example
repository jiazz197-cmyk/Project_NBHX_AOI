# ============================================================
# Project_NBHX_AOI - Label Studio 环境变量示例
# 复制为 .env 后按实际环境修改：
#   cp .env.example .env
#
# 注意：
# 1. 仓库根目录的 .env 会被 Django 自动读取（django-environ）；
#    真实 shell 环境变量优先，不会覆盖 export 过的同名变量。
#    修改 .env 后需要重启后端才能生效。
# 2. 代码默认已经不用 SQLite。
# 3. 本地开发默认走 PostgreSQL + MinIO；如果临时不需要 MinIO，
#    可设置 MINIO_SKIP=true。
# ============================================================

# ---------- 数据库：PostgreSQL（默认） ----------
DJANGO_DB=default

# 本机直连 PostgreSQL：
POSTGRE_HOST=localhost
POSTGRE_PORT=5432
# 库名必须与 PostgreSQL 容器中实际存在的库一致。
# 本仓库 docker-compose 与默认开发库均为 postgres（业务数据/迁移都在这个库里）。
# 变量名必须是 POSTGRE_*（不是 docker 官方镜像的 POSTGRES_*）；
# docker-compose.yml 会把这里的 POSTGRE_USER/POSTGRE_PASSWORD/POSTGRE_NAME
# 映射成 db 容器的 POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB，因此只维护这一套即可。
POSTGRE_NAME=postgres
POSTGRE_USER=postgres
POSTGRE_PASSWORD=postgres

# 如果使用 docker-compose 内网：
# POSTGRE_HOST 无需改（compose 内 app 服务已固定 POSTGRE_HOST=db），
# 只需保证 POSTGRE_USER/POSTGRE_PASSWORD/POSTGRE_NAME 与 db 容器一致。

# ---------- MinIO：用于存数据集图片/上传文件 ----------
# 代码默认会连 http://localhost:9000；这里显式写出来便于修改。
# Docker compose 内网模式请改成：
# MINIO_STORAGE_ENDPOINT=http://minio:9000
# 本机直接连接 MinIO：
MINIO_STORAGE_ENDPOINT=http://localhost:9000
MINIO_STORAGE_BUCKET_NAME=aoi-images
MINIO_STORAGE_ACCESS_KEY=minioadmin
MINIO_STORAGE_SECRET_KEY=minioadmin
# 临时跳过 MinIO 时可设为 true
MINIO_SKIP=false

# ---------- MinIO 控制台/服务 ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z

# ---------- AOI 二开（平台 A）----------
# B→A 错图回传的内部令牌（X-Internal-Token）。生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# 安全约束（P0）：**生产（DEBUG=false）必须显式配置**；未配置时 /api/ingest/findings 一律 40100（fail closed），
# 只在 DEBUG=true 时才回落到开发用默认值。
INTERNAL_TOKEN=
# 预标 ML backend 端点是否强制内部头：LS 1.24 调用时不带该头，默认 false（见契约 §2.4）
AOI_PRELABEL_REQUIRE_INTERNAL_TOKEN=false
# 模型发布目标（D3 起用）：registry 地址 / 镜像仓库 / 只读或读写凭据
# 仓库与账号分配见 docs/docker-registry-setup.md（A 平台用读写凭据，B 平台只读拉取）
MODEL_REGISTRY=docker.io
MODEL_IMAGE_REPO=rekal1018/aoi-model
MODEL_REGISTRY_USER=
MODEL_REGISTRY_PASSWORD=
# 发布失败重试次数（指数退避；D7 Celery worker 使用，D3 同步发布只累计 attempts）
PUBLISH_RETRY=3
# ---------- 发布服务（D3 发布 stub：假 build + 双模式 push）----------
# 发布模式：
#   fake     = 纯离线假推送（默认）：产物在内存构建，digest 取本地 manifest sha256，不联网；
#   registry = 走 Registry v2 HTTP API 真推送（token → blob 上传 → manifest PUT），需配好下面两项。
AOI_PUBLISH_MODE=fake
# registry 模式推送用的 HTTP 代理：**只作用于 registry/auth 出网**，不影响平台其它请求；空 = 直连。
# 内网机房 Docker Hub 直连不通时填本机实际代理；下面 127.0.0.1:10809 只是**格式占位示例**（并非真实端口），
# 请按本机代理实际监听地址/端口修改。
AOI_REGISTRY_PROXY=http://127.0.0.1:10809
# 发布产物落盘目录（相对路径按仓库根解析；tmp/ 已在 .gitignore，不会进版本库）；空 = 不落盘。
# 落盘内容：model/{model.onnx, model.onnx.sha256, model.yaml} + artifacts/{layer.tar.gz, config.json,
# manifest.json, digest.txt} + Dockerfile + push.sh（有网机器手工直推的临时通道）。
AOI_PUBLISH_ARTIFACTS_DIR=tmp/publish

# ---------- 本地开发：前端联调（仅开发环境，生产必须关闭） ----------
# false：Django 从构建产物加载前端（读 STATIC_ROOT/js/manifest.json，由
#        `cd web && bun run build` + `manage.py collectstatic` 生成）。
#        URL 为同源相对路径，localhost / 服务器 IP / 端口转发都能访问。
# true ：Django 把前端模块与样式指向 Vite 开发服务器，地址取自 FRONTEND_HOSTNAME
#        （未设置时默认 http://localhost:8010），该绝对地址会直接写进 HTML。
#        远程访问必须显式设置 FRONTEND_HOSTNAME=http://<浏览器可达的IP>:8010，
#        否则远程浏览器会把 localhost 解析到自己机器上 —— 白屏且标签页一直转圈。
FRONTEND_HMR=false
# DEBUG=true 让 runserver 提供 /static/ 下的样式等静态文件，本地开发必须开启。
DEBUG=true
