# ============================================================
# Project_NBHX_AOI - Label Studio 环境变量示例
# 复制为 .env 后按实际环境修改：
#   cp .env.example .env
#
# 注意：
# 1. 仓库根目录的 .env 会被 Django 自动读取（django-environ）；
#    真实 shell 环境变量优先，不会覆盖 export 过的同名变量。
#    修改 .env 后需要重启后端才能生效。
# 2. 代码默认已经不用 SQLite。
# 3. 本地开发默认走 PostgreSQL + MinIO；如果临时不需要 MinIO，
#    可设置 MINIO_SKIP=true。
# ============================================================

# ---------- 数据库：PostgreSQL（默认） ----------
DJANGO_DB=default

# 本机直连 PostgreSQL：
POSTGRE_HOST=localhost
POSTGRE_PORT=5432
# 库名必须与 PostgreSQL 容器中实际存在的库一致。
# 本仓库 docker-compose 与默认开发库均为 postgres（业务数据/迁移都在这个库里）。
POSTGRE_NAME=postgres
POSTGRE_USER=postgres
POSTGRE_PASSWORD=postgres

# 如果使用 docker-compose 内网，请改成：
# POSTGRE_HOST=db
# POSTGRE_PASSWORD=postgres

# ---------- MinIO：用于存数据集图片/上传文件 ----------
# 代码默认会连 http://localhost:9000；这里显式写出来便于修改。
# Docker compose 内网模式请改成：
# MINIO_STORAGE_ENDPOINT=http://minio:9000
# 本机直接连接 MinIO：
MINIO_STORAGE_ENDPOINT=http://localhost:9000
MINIO_STORAGE_BUCKET_NAME=aoi-images
MINIO_STORAGE_ACCESS_KEY=minioadmin
MINIO_STORAGE_SECRET_KEY=minioadmin
# 临时跳过 MinIO 时可设为 true
MINIO_SKIP=false

# ---------- MinIO 控制台/服务 ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z

# ---------- 本地开发：前端联调（仅开发环境，生产必须关闭） ----------
# FRONTEND_HMR=true 时，Django 页面会从 Vite 开发服务器(8010)加载前端模块与样式，
# 浏览器只需访问 http://localhost:8080；不要直接打开 http://localhost:8010（会白屏）。
FRONTEND_HMR=true
# DEBUG=true 让 runserver 提供 /static/ 下的样式等静态文件，本地开发必须开启。
DEBUG=true
