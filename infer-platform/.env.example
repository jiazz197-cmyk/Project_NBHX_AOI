# ============================================================
# 平台 B（推理检测平台）环境变量
# ============================================================
# 用法：cp .env.example .env  然后按实际情况修改
# 对齐文档：docs/contracts/平台B_接口与数据契约.md §10
# ============================================================

# ---------- 服务 ----------
# 后端 HTTP 监听端口
PORT=8990
# 服务时区（日报以此时区切日）
TZ=Asia/Shanghai
# 部署实例编号，多实例时用于区分回传来源
INSTANCE_CODE=B01
# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# SQLite 数据库文件路径
DB_PATH=/data/infra/data/infer.db

# ---------- 文件存储 ----------
# 运行时数据根目录，子目录已预建：
#   findings/  待回传A的可疑图与坏图
#   thumbs/    检测记录缩略图
#   models/    ONNX 模型权重
#   reports/   日报 HTML / CSV
#   logs/      运行日志
#   tmp/       模型拉取临时文件
DATA_DIR=/data/infra/data

# ---------- 模型拉取 ----------
# 镜像仓库地址
MODEL_REGISTRY=docker.io
# B平台仅需只读权限（拉取模型）
MODEL_REGISTRY_USER=rekal1018
MODEL_REGISTRY_TOKEN=<dockerhub-readonly-access-token>
# 拉取方式：oci（Registry HTTP API，无需 Docker daemon）| docker（本机 docker CLI）
MODEL_PULL_MODE=oci

# ---------- 对接平台 A ----------
# 平台 A 的访问基址（错图回传目标）
TRAIN_PLATFORM_BASE_URL=
# 回传认证令牌，由 A 侧签发，请求头 X-Internal-Token 携带
INTERNAL_TOKEN=

# ---------- 推理 ----------
# 推理并发数，依据 GPU 显存调整
INSPECT_CONCURRENCY=2
# 推理等待队列最大长度，超限返回 429
INSPECT_QUEUE_MAX=32
# 单图推理超时时间（毫秒），超时判定为 manual
INFER_TIMEOUT_MS=10000
# ONNX 推理后端：cuda（NVIDIA GPU）| cpu（纯 CPU）
ONNX_PROVIDER=cuda

# ---------- 存储保留策略 ----------
# auto_pass 图片是否保留原图
AUTO_PASS_KEEP_IMAGE=false
# auto_pass 图片是否保留缩略图
AUTO_PASS_KEEP_THUMB=true
# 图片保留天数（未回传成功的图片不会被清理）
IMAGE_RETENTION_DAYS=30
# 本地保留的模型版本数量
MODEL_KEEP_VERSIONS=3
# 日报保留天数
REPORT_RETENTION_DAYS=90

# ---------- 定时任务 ----------
# 日报生成时间（cron 表达式，默认每日 00:10）
REPORT_CRON="10 0 * * *"
# 回传队列最大保留小时数，超时标记为 dead
OUTBOX_MAX_AGE_HOURS=24
# 模型拉取临时目录保留小时数
PULL_TMP_TTL_HOURS=24