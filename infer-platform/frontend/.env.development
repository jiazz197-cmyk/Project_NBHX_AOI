# 前端开发环境配置
# 复制为 .env.development.local 修改（不入库）

# === API 代理目标 ===
# 方式1: 本地后端（角色C开发的后端）
# VITE_API_TARGET=http://localhost:8990

# 方式2: Apifox Mock（导入 openapi.json 后获取）
# VITE_API_TARGET=http://127.0.0.1:4523/mock/你的项目ID

# 方式3: 不设置则默认 localhost:8990

# === 数据模式 ===
# mock: 使用内置假数据（src/api/mock.ts），不需要后端
# api: 调用真实接口（需要后端或Apifox在线）
VITE_DATA_MODE=mock